{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "playfirstlight.vercel.app" }],
      "status": 307,
      "headers": { "Location": "https://firstlight.one4all.dev/$1" }
    },
    {
      "src": "/api/auth/(.*)",
      "dest": "https://api.firstlight.one4all.dev/api/auth/$1",
      "headers": { "x-vercel-enable-rewrite-caching": "0", "cache-control": "no-store" },
      "transforms": [
        { "type": "request.headers", "op": "set", "target": { "key": "x-origin-secret" }, "args": "$ORIGIN_SECRET", "env": ["ORIGIN_SECRET"] }
      ]
    },
    { "src": "/assets/(.*)", "headers": { "cache-control": "public, max-age=31536000, immutable" }, "continue": true },
    { "handle": "filesystem" }
  ]
}
