{
  "name": "@firstlight/client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p e2e/tsconfig.json",
    "test": "vitest run",
    "deploy": "vite build && cp -R .vercel dist/.vercel && vercel deploy dist --prod --yes",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@colyseus/schema": "5.0.36",
    "@colyseus/sdk": "0.18.5",
    "@dgreenheck/three-pinata": "2.0.1",
    "@firstlight/shared": "workspace:*",
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "better-auth": "1.7.7",
    "three": "0.186.1",
    "zzfx": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/three": "0.186.0",
    "vite": "8.3.4"
  }
}
